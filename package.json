  "author": "opencode-opendeck contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptthien1012/opencode-opendeck.git"
  },
  "homepage": "https://github.com/ptthien1012/opencode-opendeck#readme",
  "bugs": {
    "url": "https://github.com/ptthien1012/opencode-opendeck/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "dashboard",
    "opendeck",
    "agents",
    "git",
    "diff",
    "usage"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "exports": {
